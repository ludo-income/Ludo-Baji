# Existing Render deployments may use ADMIN_MOBILE and JWT_SECRET; the server accepts those names too.
# REQUIRED ADMIN SECURITY
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=use_a_strong_unique_password
ADMIN_SECRET=replace_with_a_random_secret_at_least_32_characters
USER_SECRET=replace_with_a_different_random_secret_at_least_32_characters
ADMIN_ROLE=super_admin
ADMIN_TOKEN_TTL_MINUTES=480
ADMIN_LOGIN_MAX_ATTEMPTS=5
MAX_BODY_MB=10
# Optional: only set when a separate frontend origin must call the API
CORS_ORIGIN=
TRUST_PROXY=false

# User Login / OTP
USER_LOGIN_OTP=true
OTP_TTL_SECONDS=300
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Production email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=yourgmail@gmail.com

# Testing only; keep false in production
OTP_DEV_MODE=false
